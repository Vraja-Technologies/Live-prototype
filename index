<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vraja × Inde Wild — Odoo ERP Prototype</title>
    <!-- Tailwind CSS for UI -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        odoo: {
                            purple: '#714B67',
                            'purple-dark': '#5a3b52',
                            teal: '#00A09D',
                            'teal-dark': '#008784',
                            gray: '#F9FAFB',
                            border: '#E5E7EB',
                            sidebar: '#1F2937',
                            header: '#111827'
                        },
                        indewild: {
                            burgundy: '#4A1525',
                            rose: '#E8D5C8',
                            gold: '#C5A059',
                            cream: '#FDFBF7'
                        },
                        vraja: {
                            blue: '#0F52BA',
                            navy: '#0A2540'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif']
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom Odoo Scrollbars & Styling */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }
        .kanban-column {
            min-height: calc(100vh - 220px);
        }
        .badge-draft { background-color: #E5E7EB; color: #374151; }
        .badge-sent { background-color: #DBEAFE; color: #1E40AF; }
        .badge-po { background-color: #FEF3C7; color: #92400E; }
        .badge-done { background-color: #D1FAE5; color: #065F46; }
        .badge-cancel { background-color: #FEE2E2; color: #991B1B; }

        .active-tab {
            background-color: rgba(255, 255, 255, 0.15);
            font-weight: 600;
        }
        .toast-enter {
            transform: translateY(100%);
            opacity: 0;
            transition: all 0.3s ease-out;
        }
        .toast-show {
            transform: translateY(0);
            opacity: 1;
        }
    </style>
</head>
<body class="bg-gray-100 font-sans text-gray-800 antialiased h-screen flex flex-col overflow-hidden">

    <!-- Top Demo Header Bar -->
    <header class="bg-vraja-navy text-white text-xs px-4 py-1.5 flex justify-between items-center z-50 border-b border-gray-700">
        <div class="flex items-center space-x-3">
            <span class="font-bold tracking-wider text-blue-400">VRAJA</span>
            <span class="text-gray-400">×</span>
            <span class="font-serif italic text-indewild-rose">indē wild</span>
            <span class="bg-amber-500/20 text-amber-300 text-[10px] px-2 py-0.5 rounded-full border border-amber-500/30 uppercase font-semibold tracking-wide ml-2">
                Simulated Odoo ERP Environment
            </span>
        </div>
        <div class="flex items-center space-x-4">
            <span class="text-gray-300 hidden md:inline">Operations Executive Prototype</span>
            <button onclick="resetDataModel()" class="hover:text-amber-300 text-gray-400 transition-colors flex items-center gap-1 text-[11px]">
                <i data-lucide="rotate-ccw" class="w-3 h-3"></i> Reset Demo Data
            </button>
        </div>
    </header>

    <!-- App Container -->
    <div class="flex-1 flex flex-col overflow-hidden relative" id="app-container">

        <!-- ODOO TOP NAVIGATION BAR (Visible inside app views) -->
        <nav id="odoo-top-nav" class="bg-odoo-purple text-white flex items-center justify-between px-4 py-2 shadow-md z-40 hidden">
            <div class="flex items-center space-x-4">
                <!-- App Switcher Dropdown -->
                <div class="relative group">
                    <button class="flex items-center space-x-2 px-3 py-1.5 rounded hover:bg-white/10 transition">
                        <i data-lucide="grid" class="w-5 h-5"></i>
                        <span id="current-app-name" class="font-bold text-lg tracking-wide">Inventory</span>
                        <i data-lucide="chevron-down" class="w-4 h-4"></i>
                    </button>
                    <!-- Dropdown Menu -->
                    <div class="absolute top-full left-0 mt-1 w-56 bg-white text-gray-800 rounded-lg shadow-xl border border-gray-200 hidden group-hover:block z-50 py-2">
                        <div class="px-3 py-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Odoo Applications</div>
                        <a href="#" onclick="switchView('inventory')" class="flex items-center space-x-3 px-4 py-2 hover:bg-purple-50 hover:text-odoo-purple">
                            <i data-lucide="box" class="w-4 h-4 text-odoo-purple"></i>
                            <span class="font-medium">Inventory</span>
                        </a>
                        <a href="#" onclick="switchView('purchase')" class="flex items-center space-x-3 px-4 py-2 hover:bg-purple-50 hover:text-odoo-purple">
                            <i data-lucide="shopping-cart" class="w-4 h-4 text-emerald-600"></i>
                            <span class="font-medium">Purchase</span>
                        </a>
                        <a href="#" onclick="switchView('project')" class="flex items-center space-x-3 px-4 py-2 hover:bg-purple-50 hover:text-odoo-purple">
                            <i data-lucide="kanban" class="w-4 h-4 text-blue-600"></i>
                            <span class="font-medium">Project</span>
                        </a>
                        <div class="border-t border-gray-100 my-1"></div>
                        <a href="#" onclick="switchView('workflow')" class="flex items-center space-x-3 px-4 py-2 hover:bg-purple-50 hover:text-odoo-purple">
                            <i data-lucide="git-merge" class="w-4 h-4 text-amber-600"></i>
                            <span class="font-medium">End-to-End Workflow</span>
                        </a>
                        <a href="#" onclick="switchView('supporting')" class="flex items-center space-x-3 px-4 py-2 hover:bg-purple-50 hover:text-odoo-purple">
                            <i data-lucide="layers" class="w-4 h-4 text-indigo-600"></i>
                            <span class="font-medium">Supporting Apps</span>
                        </a>
                    </div>
                </div>

                <!-- Horizontal App Navigation Links -->
                <div class="hidden md:flex items-center space-x-1 text-sm">
                    <button onclick="switchView('intro')" class="px-3 py-1 rounded hover:bg-white/10 text-purple-200 hover:text-white">Cover</button>
                    <button id="nav-inventory" onclick="switchView('inventory')" class="px-3 py-1 rounded hover:bg-white/10">Inventory</button>
                    <button id="nav-purchase" onclick="switchView('purchase')" class="px-3 py-1 rounded hover:bg-white/10">Purchase</button>
                    <button id="nav-project" onclick="switchView('project')" class="px-3 py-1 rounded hover:bg-white/10">Project</button>
                    <button id="nav-workflow" onclick="switchView('workflow')" class="px-3 py-1 rounded hover:bg-white/10 font-semibold text-amber-300">Live Workflow</button>
                    <button id="nav-supporting" onclick="switchView('supporting')" class="px-3 py-1 rounded hover:bg-white/10">More Apps</button>
                </div>
            </div>

            <!-- User Profile & System Indicators -->
            <div class="flex items-center space-x-3 text-sm">
                <span class="hidden sm:inline-block bg-white/10 px-2.5 py-0.5 rounded text-xs">Inde Wild Warehouse 01</span>
                <div class="w-8 h-8 rounded-full bg-indewild-rose text-odoo-purple font-bold flex items-center justify-center text-xs shadow border border-white/20">
                    OE
                </div>
            </div>
        </nav>

        <!-- MAIN CONTENT AREA -->
        <main class="flex-1 overflow-y-auto bg-gray-50 relative">

            <!-- VIEW 1: PRESENTATION COVER / INTRO -->
            <section id="view-intro" class="min-h-full flex flex-col justify-between p-6 md:p-12 bg-gradient-to-br from-indewild-cream via-white to-rose-50/40">
                <div class="max-w-6xl mx-auto w-full flex-1 flex flex-col justify-center my-8">
                    
                    <!-- Top Branding Bar -->
                    <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-gray-200/80">
                        <div class="flex items-center space-x-4">
                            <div class="bg-vraja-navy text-white text-xl font-black px-4 py-2 rounded shadow tracking-wider">VRAJA</div>
                            <span class="text-2xl text-gray-300 font-light">×</span>
                            <div class="font-serif text-2xl font-bold tracking-tight text-indewild-burgundy italic">indē wild</div>
                        </div>
                        <div class="text-xs text-right font-medium text-gray-500 uppercase tracking-wider">
                            Tailored Odoo 17 ERP Proposal Prototype
                        </div>
                    </div>

                    <!-- Main Hero Header -->
                    <div class="max-w-3xl mb-12">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-100/60 border border-rose-200 text-indewild-burgundy text-xs font-semibold uppercase tracking-wider mb-4">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-indewild-gold"></i> Operational Transformation Strategy
                        </div>
                        <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 leading-tight mb-4">
                            Connected Operations.<br><span class="text-odoo-purple">Complete Visibility.</span>
                        </h1>
                        <p class="text-lg text-gray-600 leading-relaxed font-light">
                            Designed specifically for Inde Wild's Operations team. Seamlessly connect skincare inventory forecasting, purchase orders, vendor management, and product launch tasks within a unified Odoo ERP ecosystem.
                        </p>
                    </div>

                    <!-- App Quick Launch Cards Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                        <!-- Inventory Card -->
                        <div onclick="switchView('inventory')" class="group cursor-pointer bg-white p-6 rounded-xl border border-gray-200 hover:border-odoo-purple hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
                            <div>
                                <div class="w-12 h-12 rounded-lg bg-purple-100 text-odoo-purple flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                                    <i data-lucide="box" class="w-6 h-6"></i>
                                </div>
                                <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-odoo-purple transition-colors">Inventory Control</h3>
                                <p class="text-sm text-gray-500 leading-relaxed">
                                    Real-time tracking of finished goods, raw ingredients (Organic Saffron), packaging stock, and automated reorder alerts.
                                </p>
                            </div>
                            <div class="mt-6 flex items-center text-sm font-semibold text-odoo-purple">
                                Explore Module <i data-lucide="arrow-right" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform"></i>
                            </div>
                        </div>

                        <!-- Purchase Card -->
                        <div onclick="switchView('purchase')" class="group cursor-pointer bg-white p-6 rounded-xl border border-gray-200 hover:border-emerald-600 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
                            <div>
                                <div class="w-12 h-12 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                                    <i data-lucide="shopping-cart" class="w-6 h-6"></i>
                                </div>
                                <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-emerald-600 transition-colors">Purchase & Vendors</h3>
                                <p class="text-sm text-gray-500 leading-relaxed">
                                    Streamlined RFQs, purchase orders for bio-botanicals and packaging glass, lead-time tracking, and automated stock receipting.
                                </p>
                            </div>
                            <div class="mt-6 flex items-center text-sm font-semibold text-emerald-600">
                                Explore Module <i data-lucide="arrow-right" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform"></i>
                            </div>
                        </div>

                        <!-- Project Card -->
                        <div onclick="switchView('project')" class="group cursor-pointer bg-white p-6 rounded-xl border border-gray-200 hover:border-blue-600 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
                            <div>
                                <div class="w-12 h-12 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                                    <i data-lucide="kanban" class="w-6 h-6"></i>
                                </div>
                                <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">Project & Launch Ops</h3>
                                <p class="text-sm text-gray-500 leading-relaxed">
                                    Kanban boards for skincare batch launches, packaging revisions, compliance audits, and cross-department collaboration.
                                </p>
                            </div>
                            <div class="mt-6 flex items-center text-sm font-semibold text-blue-600">
                                Explore Module <i data-lucide="arrow-right" class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Call to Action Buttons -->
                    <div class="flex flex-wrap items-center gap-4">
                        <button onclick="switchView('workflow')" class="px-8 py-3.5 bg-odoo-purple text-white font-semibold rounded-lg hover:bg-odoo-purple-dark transition shadow-lg hover:shadow-purple-900/20 flex items-center space-x-2">
                            <i data-lucide="play-circle" class="w-5 h-5 text-amber-300"></i>
                            <span>Run Interactive Workflow Demo</span>
                        </button>
                        <button onclick="switchView('inventory')" class="px-6 py-3.5 bg-white text-gray-700 font-semibold rounded-lg border border-gray-300 hover:bg-gray-50 transition shadow-sm">
                            Open Odoo Apps Dashboard
                        </button>
                    </div>

                </div>

                <!-- Footer Notes -->
                <div class="text-xs text-gray-400 text-center border-t border-gray-200 pt-4 max-w-6xl mx-auto w-full flex flex-col sm:flex-row justify-between items-center gap-2">
                    <div>Vraja Strategic ERP Consultancy Services — Prepared for Inde Wild</div>
                    <div>Interactive HTML5 Prototype • Powered by Odoo 17 Architecture Reference</div>
                </div>
            </section>

            <!-- VIEW 2: ODOO INVENTORY MODULE -->
            <section id="view-inventory" class="h-full flex flex-col hidden">
                <!-- Control Header Panel -->
                <div class="bg-white border-b border-gray-200 px-6 py-3 flex flex-wrap items-center justify-between gap-4 shadow-sm">
                    <div class="flex items-center space-x-3">
                        <span class="text-sm text-gray-500 font-medium">Inventory</span>
                        <span class="text-gray-300">/</span>
                        <span class="font-bold text-gray-800 text-lg">Products & Stock Levels</span>
                    </div>

                    <!-- Actions & Filters -->
                    <div class="flex items-center space-x-3">
                        <div class="relative">
                            <i data-lucide="search" class="w-4 h-4 text-gray-400 absolute left-3 top-2.5"></i>
                            <input type="text" id="inventory-search" oninput="filterInventory()" placeholder="Search products, SKU..." class="pl-9 pr-4 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-odoo-purple w-64">
                        </div>
                        <select id="inventory-filter" onchange="filterInventory()" class="text-sm border border-gray-300 rounded-md px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-odoo-purple bg-white">
                            <option value="all">All Replenishment Statuses</option>
                            <option value="Low Stock">Low Stock Alert</option>
                            <option value="Optimal">Optimal Stock</option>
                            <option value="Reorder Required">Reorder Required</option>
                        </select>
                        <button onclick="openReceiveStockModal()" class="bg-odoo-purple hover:bg-odoo-purple-dark text-white px-3.5 py-1.5 rounded-md text-sm font-medium flex items-center space-x-1.5 shadow-sm transition">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                            <span>Receive Stock</span>
                        </button>
                    </div>
                </div>

                <!-- Overview KPI Cards -->
                <div class="p-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm flex items-center justify-between">
                        <div>
                            <div class="text-xs text-gray-500 font-medium uppercase tracking-wider">Total Products</div>
                            <div class="text-2xl font-bold text-gray-900 mt-1" id="kpi-total-products">5</div>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-purple-50 text-odoo-purple flex items-center justify-center">
                            <i data-lucide="package" class="w-5 h-5"></i>
                        </div>
                    </div>
                    <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm flex items-center justify-between">
                        <div>
                            <div class="text-xs text-gray-500 font-medium uppercase tracking-wider">Low Stock Items</div>
                            <div class="text-2xl font-bold text-amber-600 mt-1" id="kpi-low-stock">2</div>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center">
                            <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                        </div>
                    </div>
                    <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm flex items-center justify-between">
                        <div>
                            <div class="text-xs text-gray-500 font-medium uppercase tracking-wider">Incoming Orders</div>
                            <div class="text-2xl font-bold text-blue-600 mt-1" id="kpi-incoming">3</div>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center">
                            <i data-lucide="truck" class="w-5 h-5"></i>
                        </div>
                    </div>
                    <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm flex items-center justify-between">
                        <div>
                            <div class="text-xs text-gray-500 font-medium uppercase tracking-wider">Warehouse Locations</div>
                            <div class="text-2xl font-bold text-emerald-600 mt-1">2</div>
                        </div>
                        <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center">
                            <i data-lucide="map-pin" class="w-5 h-5"></i>
                        </div>
                    </div>
                </div>

                <!-- Main Data Table -->
                <div class="flex-1 px-6 pb-6 overflow-x-auto">
                    <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
                        <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
                            <thead class="bg-gray-50 text-gray-500 uppercase text-xs font-semibold tracking-wider">
                                <tr>
                                    <th class="px-6 py-3">Product Name</th>
                                    <th class="px-6 py-3">Internal Ref (SKU)</th>
                                    <th class="px-6 py-3">Location</th>
                                    <th class="px-6 py-3">On-Hand Qty</th>
                                    <th class="px-6 py-3">Forecasted Qty</th>
                                    <th class="px-6 py-3">Status</th>
                                    <th class="px-6 py-3 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="inventory-table-body" class="divide-y divide-gray-200 bg-white">
                                <!-- Dynamic Rows Injected by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- VIEW 3: ODOO PURCHASE MODULE -->
            <section id="view-purchase" class="h-full flex flex-col hidden">
                <!-- Control Header Panel -->
                <div class="bg-white border-b border-gray-200 px-6 py-3 flex flex-wrap items-center justify-between gap-4 shadow-sm">
                    <div class="flex items-center space-x-3">
                        <span class="text-sm text-gray-500 font-medium">Purchase</span>
                        <span class="text-gray-300">/</span>
                        <span class="font-bold text-gray-800 text-lg">Requests for Quotation & Orders</span>
                    </div>

                    <!-- Actions & Filters -->
                    <div class="flex items-center space-x-3">
                        <div class="relative">
                            <i data-lucide="search" class="w-4 h-4 text-gray-400 absolute left-3 top-2.5"></i>
                            <input type="text" id="purchase-search" oninput="filterPurchase()" placeholder="Search PO, Vendor..." class="pl-9 pr-4 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-odoo-purple w-64">
                        </div>
                        <button onclick="openNewRFQModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-1.5 rounded-md text-sm font-medium flex items-center space-x-1.5 shadow-sm transition">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                            <span>Create RFQ</span>
                        </button>
                    </div>
                </div>

                <!-- Purchase Orders Table -->
                <div class="flex-1 p-6 overflow-x-auto">
                    <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
                        <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
                            <thead class="bg-gray-50 text-gray-500 uppercase text-xs font-semibold tracking-wider">
                                <tr>
                                    <th class="px-6 py-3">Reference</th>
                                    <th class="px-6 py-3">Vendor</th>
                                    <th class="px-6 py-3">Item Requested</th>
                                    <th class="px-6 py-3">Quantity</th>
                                    <th class="px-6 py-3">Total Amount</th>
                                    <th class="px-6 py-3">Order Status</th>
                                    <th class="px-6 py-3 text-right">Workflow Actions</th>
                                </tr>
                            </thead>
                            <tbody id="purchase-table-body" class="divide-y divide-gray-200 bg-white">
                                <!-- Dynamic PO Rows Injected by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- VIEW 4: ODOO PROJECT MANAGEMENT MODULE -->
            <section id="view-project" class="h-full flex flex-col hidden">
                <!-- Control Header Panel -->
                <div class="bg-white border-b border-gray-200 px-6 py-3 flex flex-wrap items-center justify-between gap-4 shadow-sm">
                    <div class="flex items-center space-x-3">
                        <span class="text-sm text-gray-500 font-medium">Project</span>
                        <span class="text-gray-300">/</span>
                        <span class="font-bold text-gray-800 text-lg">Inde Wild Operations & Launches</span>
                    </div>

                    <div class="flex items-center space-x-3">
                        <button onclick="openNewTaskModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-3.5 py-1.5 rounded-md text-sm font-medium flex items-center space-x-1.5 shadow-sm transition">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                            <span>New Task</span>
                        </button>
                    </div>
                </div>

                <!-- Kanban Board Area -->
                <div class="flex-1 p-6 overflow-x-auto">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 h-full min-w-[900px]">
                        
                        <!-- Column: Backlog -->
                        <div class="bg-gray-100/70 p-4 rounded-xl border border-gray-200 flex flex-col">
                            <div class="flex justify-between items-center mb-4">
                                <h4 class="font-bold text-gray-700 text-sm flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 rounded-full bg-gray-400"></span> Backlog
                                </h4>
                                <span class="bg-gray-200 text-gray-600 text-xs px-2 py-0.5 rounded-full font-semibold" id="count-backlog">0</span>
                            </div>
                            <div id="kanban-backlog" class="space-y-3 flex-1 overflow-y-auto pr-1">
                                <!-- Tasks dynamically populated -->
                            </div>
                        </div>

                        <!-- Column: In Progress -->
                        <div class="bg-gray-100/70 p-4 rounded-xl border border-gray-200 flex flex-col">
