    <script>
        // INITIAL DEMO DATA MODEL
        const DEFAULT_DATA = {
            products: [
                { id: 'P01', name: 'Organic Saffron Extract (1kg)', sku: 'RAW-SAF-001', location: 'WH/Stock A1', qty: 2, forecast: 12, status: 'Reorder Required' },
                { id: 'P02', name: 'AM Sunrise Serum (50ml)', sku: 'FG-SER-050', location: 'WH/Stock B2', qty: 140, forecast: 180, status: 'Optimal' },
                { id: 'P03', name: 'Dewy Lip Balm (15g)', sku: 'FG-BAL-015', location: 'WH/Stock B3', qty: 15, forecast: 65, status: 'Low Stock' },
                { id: 'P04', name: 'Glass Packaging Jar (50ml)', sku: 'PKG-JAR-050', location: 'WH/Stock C1', qty: 400, forecast: 400, status: 'Optimal' },
                { id: 'P05', name: 'Moon Cream Moisturizer', sku: 'FG-CRM-050', location: 'WH/Stock B1', qty: 8, forecast: 48, status: 'Low Stock' }
            ],
            purchases: [
                { id: 'PO00104', vendor: 'BioBotanicals India Ltd', item: 'Organic Saffron Extract (1kg)', productId: 'P01', qty: 10, total: 2500, status: 'Draft' },
                { id: 'PO00105', vendor: 'Luxe Glass Packaging Co.', item: 'Glass Packaging Jar (50ml)', productId: 'P04', qty: 500, total: 1250, status: 'Purchase Order' }
            ],
            tasks: [
                { id: 'T01', title: 'Supplier Audit: Organic Saffron', assignee: 'Ops Exec', stage: 'progress', priority: 'High' },
                { id: 'T02', title: 'Packaging Revision: Dewy Balm V2', assignee: 'Design Team', stage: 'review', priority: 'Medium' },
                { id: 'T03', title: 'Batch #88 Quality Testing', assignee: 'QA Manager', stage: 'backlog', priority: 'High' },
                { id: 'T04', title: 'Q4 Warehouse Stock Reconciliation', assignee: 'Ops Exec', stage: 'done', priority: 'Low' }
            ]
        };

        let appState = loadState();

        function loadState() {
            const stored = localStorage.getItem('vraja_odoo_prototype_state');
            return stored ? JSON.parse(stored) : JSON.parse(JSON.stringify(DEFAULT_DATA));
        }

        function saveState() {
            localStorage.setItem('vraja_odoo_prototype_state', JSON.stringify(appState));
            renderAllViews();
        }

        function resetDataModel() {
            localStorage.removeItem('vraja_odoo_prototype_state');
            appState = JSON.parse(JSON.stringify(DEFAULT_DATA));
            renderAllViews();
            showToast('Demo data successfully reset!', 'info');
        }

        // NAVIGATION & VIEW SWITCHING
        function switchView(viewName) {
            const views = ['intro', 'inventory', 'purchase', 'project', 'workflow', 'supporting'];
            views.forEach(v => {
                const el = document.getElementById(`view-${v}`);
                if (el) el.classList.add('hidden');
            });

            const topNav = document.getElementById('odoo-top-nav');
            if (viewName === 'intro') {
                topNav.classList.add('hidden');
            } else {
                topNav.classList.remove('hidden');
            }

            const targetView = document.getElementById(`view-${viewName}`);
            if (targetView) targetView.classList.remove('hidden');

            // Update app title display in nav
            const appNameMap = {
                inventory: 'Inventory',
                purchase: 'Purchase',
                project: 'Project',
                workflow: 'End-to-End Workflow',
                supporting: 'Supporting Applications'
            };
            if (appNameMap[viewName]) {
                document.getElementById('current-app-name').innerText = appNameMap[viewName];
            }

            // Update tab styles
            ['inventory', 'purchase', 'project', 'workflow', 'supporting'].forEach(v => {
                const btn = document.getElementById(`nav-${v}`);
                if (btn) {
                    if (v === viewName) {
                        btn.classList.add('active-tab');
                    } else {
                        btn.classList.remove('active-tab');
                    }
                }
            });

            // Re-render view specific logic if needed
            if (viewName === 'inventory') renderInventory();
            if (viewName === 'purchase') renderPurchase();
            if (viewName === 'project') renderProject();

            // Refresh lucide icons
            lucide.createIcons();
        }

        // RENDER INVENTORY
        function renderInventory() {
            const tbody = document.getElementById('inventory-table-body');
            const searchVal = document.getElementById('inventory-search')?.value.toLowerCase() || '';
            const filterVal = document.getElementById('inventory-filter')?.value || 'all';

            const filtered = appState.products.filter(p => {
                const matchesSearch = p.name.toLowerCase().includes(searchVal) || p.sku.toLowerCase().includes(searchVal);
                const matchesFilter = filterVal === 'all' || p.status === filterVal;
                return matchesSearch && matchesFilter;
            });

            tbody.innerHTML = filtered.map(p => `
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 font-semibold text-gray-900">${p.name}</td>
                    <td class="px-6 py-4 text-xs font-mono text-gray-500">${p.sku}</td>
                    <td class="px-6 py-4 text-gray-600 text-xs">${p.location}</td>
                    <td class="px-6 py-4 font-bold ${p.qty < 20 ? 'text-red-600' : 'text-gray-900'}">${p.qty} units</td>
                    <td class="px-6 py-4 text-gray-500">${p.forecast} units</td>
                    <td class="px-6 py-4">
                        <span class="px-2.5 py-1 rounded-full text-xs font-semibold ${
                            p.status === 'Optimal' ? 'bg-emerald-100 text-emerald-800' :
                            p.status === 'Low Stock' ? 'bg-amber-100 text-amber-800' : 'bg-red-100 text-red-800'
                        }">${p.status}</span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <button onclick="quickReceive('${p.id}')" class="text-xs text-odoo-purple hover:underline font-semibold">
                            + Add Receipt
                        </button>
                    </td>
                </tr>
            `).join('');

            // Update KPI counts
            document.getElementById('kpi-total-products').innerText = appState.products.length;
            document.getElementById('kpi-low-stock').innerText = appState.products.filter(p => p.qty < 20).length;
        }

        function filterInventory() { renderInventory(); }

        function quickReceive(productId) {
            const p = appState.products.find(item => item.id === productId);
            if (p) {
                p.qty += 25;
                p.forecast += 25;
                if (p.qty >= 20) p.status = 'Optimal';
                saveState();
                showToast(`Received 25 units of ${p.name}!`, 'success');
            }
        }

        // RENDER PURCHASE
        function renderPurchase() {
            const tbody = document.getElementById('purchase-table-body');
            const searchVal = document.getElementById('purchase-search')?.value.toLowerCase() || '';

            const filtered = appState.purchases.filter(po => 
                po.id.toLowerCase().includes(searchVal) || po.vendor.toLowerCase().includes(searchVal) || po.item.toLowerCase().includes(searchVal)
            );

            tbody.innerHTML = filtered.map(po => `
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-6 py-4 font-bold text-odoo-purple">${po.id}</td>
                    <td class="px-6 py-4 text-gray-900 font-medium">${po.vendor}</td>
                    <td class="px-6 py-4 text-gray-600 text-xs">${po.item}</td>
                    <td class="px-6 py-4 font-semibold">${po.qty}</td>
                    <td class="px-6 py-4 font-semibold text-gray-900">$${po.total.toLocaleString()}</td>
                    <td class="px-6 py-4">
                        <span class="px-2.5 py-1 rounded-full text-xs font-semibold ${
                            po.status === 'Draft' ? 'badge-draft' :
                            po.status === 'Purchase Order' ? 'badge-po' : 'badge-done'
                        }">${po.status}</span>
                    </td>
                    <td class="px-6 py-4 text-right space-x-2">
                        ${po.status === 'Draft' ? `
                            <button onclick="updatePOStatus('${po.id}', 'Purchase Order')" class="text-xs bg-emerald-600 text-white px-2.5 py-1 rounded hover:bg-emerald-700">Confirm Order</button>
                        ` : ''}
                        ${po.status === 'Purchase Order' ? `
                            <button onclick="receivePOShipment('${po.id}')" class="text-xs bg-odoo-purple text-white px-2.5 py-1 rounded hover:bg-odoo-purple-dark">Simulate Goods Receipt</button>
                        ` : ''}
                        ${po.status === 'Received & Stocked' ? `
                            <span class="text-xs text-emerald-600 font-semibold flex items-center justify-end gap-1"><i data-lucide="check" class="w-3.5 h-3.5"></i> Stock Sync Complete</span>
                        ` : ''}
                    </td>
                </tr>
            `).join('');
        }

        function filterPurchase() { renderPurchase(); }

        function updatePOStatus(poId, newStatus) {
            const po = appState.purchases.find(p => p.id === poId);
            if (po) {
                po.status = newStatus;
                saveState();
                showToast(`Purchase Order ${poId} confirmed!`, 'success');
            }
        }

        function receivePOShipment(poId) {
            const po = appState.purchases.find(p => p.id === poId);
            if (po) {
                po.status = 'Received & Stocked';
                // Sync stock with inventory
                const product = appState.products.find(p => p.id === po.productId || p.name === po.item);
                if (product) {
                    product.qty += po.qty;
                    if (product.qty >= 20) product.status = 'Optimal';
                }
                saveState();
                showToast(`Goods received for ${poId}! Stock updated in Inventory.`, 'success');
            }
        }

        // RENDER PROJECT (KANBAN)
        function renderProject() {
            const stages = ['backlog', 'progress', 'review', 'done'];
            
            stages.forEach(stage => {
                const container = document.getElementById(`kanban-${stage}`);
                const tasksInStage = appState.tasks.filter(t => t.stage === stage);
                
                document.getElementById(`count-${stage}`).innerText = tasksInStage.length;

                container.innerHTML = tasksInStage.map(t => `
                    <div class="bg-white p-3.5 rounded-lg border border-gray-200 shadow-sm hover:shadow-md transition cursor-pointer">
                        <div class="flex justify-between items-start mb-2">
                            <h5 class="font-bold text-gray-800 text-sm leading-snug">${t.title}</h5>
                        </div>
                        <div class="flex items-center justify-between mt-3 text-xs">
                            <span class="text-gray-500 font-medium">${t.assignee}</span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-semibold ${
                                t.priority === 'High' ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-600'
                            }">${t.priority}</span>
                        </div>
                        <!-- Stage Shifter Buttons -->
                        <div class="mt-3 pt-2 border-t border-gray-100 flex justify-between items-center text-[11px] text-gray-400">
                            ${stage !== 'backlog' ? `<button onclick="moveTask('${t.id}', 'prev')" class="hover:text-odoo-purple">← Move Back</button>` : '<span></span>'}
                            ${stage !== 'done' ? `<button onclick="moveTask('${t.id}', 'next')" class="hover:text-odoo-purple font-semibold text-odoo-purple">Advance →</button>` : '<span></span>'}
                        </div>
                    </div>
                `).join('');
            });
        }

        function moveTask(taskId, direction) {
            const stages = ['backlog', 'progress', 'review', 'done'];
            const task = appState.tasks.find(t => t.id === taskId);
            if (task) {
                let currentIndex = stages.indexOf(task.stage);
                if (direction === 'next' && currentIndex < stages.length - 1) {
                    task.stage = stages[currentIndex + 1];
                } else if (direction === 'prev' && currentIndex > 0) {
                    task.stage = stages[currentIndex - 1];
                }
                saveState();
            }
        }

        // MODAL HANDLERS
        function openReceiveStockModal() {
            const select = document.getElementById('modal-stock-product');
            select.innerHTML = appState.products.map(p => `<option value="${p.id}">${p.name} (Current: ${p.qty})</option>`).join('');
            document.getElementById('modal-receive-stock').classList.remove('hidden');
        }

        function openNewRFQModal() {
            const select = document.getElementById('rfq-product');
            select.innerHTML = appState.products.map(p => `<option value="${p.id}">${p.name}</option>`).join('');
            document.getElementById('modal-new-rfq').classList.remove('hidden');
        }

        function openNewTaskModal() {
            document.getElementById('modal-new-task').classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function handleStockReceive(e) {
            e.preventDefault();
            const pId = document.getElementById('modal-stock-product').value;
            const qty = parseInt(document.getElementById('modal-stock-qty').value);
            const p = appState.products.find(item => item.id === pId);
            if (p) {
                p.qty += qty;
                p.forecast += qty;
                if (p.qty >= 20) p.status = 'Optimal';
                saveState();
                closeModal('modal-receive-stock');
                showToast(`Successfully received ${qty} units of ${p.name}`, 'success');
            }
        }

        function handleCreateRFQ(e) {
            e.preventDefault();
            const vendor = document.getElementById('rfq-vendor').value;
            const pId = document.getElementById('rfq-product').value;
            const qty = parseInt(document.getElementById('rfq-qty').value);
            const price = parseFloat(document.getElementById('rfq-price').value);
            const p = appState.products.find(item => item.id === pId);

            const newId = `PO00${106 + appState.purchases.length}`;
            appState.purchases.unshift({
                id: newId,
                vendor: vendor,
                item: p ? p.name : 'Raw Material',
                productId: pId,
                qty: qty,
                total: qty * price,
                status: 'Draft'
            });

            saveState();
            closeModal('modal-new-rfq');
            showToast(`RFQ ${newId} created for ${vendor}`, 'success');
        }

        function handleCreateTask(e) {
            e.preventDefault();
            const title = document.getElementById('task-title').value;
            const assignee = document.getElementById('task-assignee').value;
            const stage = document.getElementById('task-stage').value;

            appState.tasks.unshift({
                id: `T0${appState.tasks.length + 1}`,
                title: title,
                assignee: assignee,
                stage: stage,
                priority: 'Medium'
            });

            saveState();
            closeModal('modal-new-task');
            showToast(`New task added to project board`, 'success');
        }

        // INTERACTIVE WORKFLOW DEMO PLAYBACK ENGINE
        let workflowInterval = null;

        function runWorkflowDemo() {
            resetWorkflowDemo();
            const btn = document.getElementById('btn-run-workflow');
            btn.disabled = true;
            btn.classList.add('opacity-50');

            const log = document.getElementById('wf-log-container');
            log.innerHTML = '';

            const steps = [
                { step: 1, title: 'Project Task Created', text: 'Low stock alert triggers operational task: "Procure Emergency Organic Saffron Extract"' },
                { step: 2, title: 'Purchase PO Confirmed', text: 'RFQ PO00104 confirmed with BioBotanicals India Ltd for 10 units @ $250/unit.' },
                { step: 3, title: 'Warehouse Receipt Processed', text: 'Shipment received at WH/Stock A1. Quality inspection passed.' },
                { step: 4, title: 'Inventory Synchronized', text: 'On-hand quantity for Saffron Extract updated dynamically from 2 to 12 units.' },
                { step: 5, title: 'Project Closed & Auto-Notified', text: 'Related project task T01 updated to DONE status. Activity log logged in Odoo Chatter.' }
            ];

            let currentStep = 0;

            function executeNextStep() {
                if (currentStep >= steps.length) {
                    clearInterval(workflowInterval);
                    btn.disabled = false;
                    btn.classList.remove('opacity-50');
                    addLog('SUCCESS', 'Interactive workflow demonstration completed successfully.');
                    showToast('End-to-End Workflow Completed!', 'success');
                    
                    // Actually update real app state to reflect workflow result
                    const saffron = appState.products.find(p => p.id === 'P01');
                    if (saffron) {
                        saffron.qty = 12;
                        saffron.status = 'Optimal';
                    }
                    const po = appState.purchases.find(p => p.id === 'PO00104');
                    if (po) po.status = 'Received & Stocked';

                    const task = appState.tasks.find(t => t.id === 'T01');
                    if (task) task.stage = 'done';

                    saveState();
                    return;
                }

                const sData = steps[currentStep];
                const card = document.getElementById(`wf-step-${sData.step}`);
                
                // Active Card Styling
                document.querySelectorAll('.wf-card').forEach(c => c.classList.remove('border-odoo-purple', 'bg-purple-50', 'shadow-lg'));
                card.classList.add('border-odoo-purple', 'bg-purple-50', 'shadow-lg');
                card.querySelector('.status-lbl').innerHTML = '<span class="text-odoo-purple font-bold">● Active Step</span>';

                addLog(`STEP ${sData.step}`, `${sData.title}: ${sData.text}`);
                currentStep++;
            }

            executeNextStep();
            workflowInterval = setInterval(executeNextStep, 2500);
        }

        function resetWorkflowDemo() {
            if (workflowInterval) clearInterval(workflowInterval);
            document.querySelectorAll('.wf-card').forEach(c => {
                c.classList.remove('border-odoo-purple', 'bg-purple-50', 'shadow-lg');
                c.querySelector('.status-lbl').innerHTML = '<span class="text-gray-400">Pending</span>';
            });
            document.getElementById('wf-log-container').innerHTML = '<div class="text-gray-500 font-sans italic">Click "Run Live Simulation" to start cross-module execution...</div>';
            const btn = document.getElementById('btn-run-workflow');
            btn.disabled = false;
            btn.classList.remove('opacity-50');
        }

        function addLog(tag, msg) {
            const container = document.getElementById('wf-log-container');
            const time = new Date().toLocaleTimeString();
            const line = document.createElement('div');
            line.className = 'flex items-start space-x-2';
            line.innerHTML = `
                <span class="text-gray-500">[${time}]</span>
                <span class="text-amber-400 font-bold">${tag}:</span>
                <span class="text-gray-200">${msg}</span>
            `;
            container.appendChild(line);
            container.scrollTop = container.scrollHeight;
        }

        // TOAST NOTIFICATIONS
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `p-4 rounded-lg shadow-xl text-white text-sm font-medium flex items-center space-x-3 pointer-events-auto transition-all duration-300 toast-enter ${
                type === 'success' ? 'bg-emerald-600' : 'bg-odoo-purple'
            }`;
            toast.innerHTML = `
                <i data-lucide="${type === 'success' ? 'check-circle' : 'info'}" class="w-5 h-5"></i>
                <span>${message}</span>
            `;
            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => {
                toast.classList.add('toast-show');
            }, 10);

            setTimeout(() => {
                toast.classList.remove('toast-show');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        function renderAllViews() {
            renderInventory();
            renderPurchase();
            renderProject();
        }

        // ON LOAD INITIALIZATION
        window.onload = function() {
            renderAllViews();
            lucide.createIcons();
        }
    </script>
</body>
</html>
